<%# local: ff = form_field form builder %>
<div data-nested-item data-controller="field-type"
     class="rounded-xl border border-gray-200 bg-gray-50/60 p-4">
  <%= ff.hidden_field :_destroy %>

  <div class="flex items-start gap-3">
    <div class="grid flex-1 gap-3 sm:grid-cols-2">
      <div>
        <%= ff.label :friendly_name, "Label", class: "block text-xs font-medium text-gray-600" %>
        <%= ff.text_field :friendly_name, placeholder: "e.g. Chief complaint",
              class: "mt-1 block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= ff.label :title, "Field key", class: "block text-xs font-medium text-gray-600" %>
        <%= ff.text_field :title, placeholder: "e.g. chief_complaint",
              class: "mt-1 block w-full rounded-lg border-gray-300 font-mono text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= ff.label :field_type, "Type", class: "block text-xs font-medium text-gray-600" %>
        <%= ff.select :field_type, field_type_options, {},
              data: { field_type_target: "type", action: "change->field-type#toggle" },
              class: "mt-1 block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= ff.label :description, "Description / hint", class: "block text-xs font-medium text-gray-600" %>
        <%= ff.text_field :description, placeholder: "Optional context for the model",
              class: "mt-1 block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <%# Options — only for single/multi select %>
      <div data-field-type-target="options" class="hidden sm:col-span-2">
        <%= ff.label :enum_options_raw, "Options (one per line)", class: "block text-xs font-medium text-gray-600" %>
        <%= ff.text_area :enum_options_raw, rows: 3, placeholder: "mild&#10;moderate&#10;severe",
              class: "mt-1 block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <%# Range — only for number %>
      <div data-field-type-target="range" class="hidden grid grid-cols-2 gap-3 sm:col-span-2">
        <div>
          <%= ff.label :minimum, "Minimum", class: "block text-xs font-medium text-gray-600" %>
          <%= ff.text_field :minimum, placeholder: "e.g. 0",
                class: "mt-1 block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <div>
          <%= ff.label :maximum, "Maximum", class: "block text-xs font-medium text-gray-600" %>
          <%= ff.text_field :maximum, placeholder: "e.g. 120",
                class: "mt-1 block w-full rounded-lg border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
      </div>
    </div>

    <button type="button" data-action="nested-form#remove"
            class="mt-5 shrink-0 rounded-md p-1.5 text-gray-400 transition hover:bg-red-50 hover:text-red-600"
            aria-label="Remove field">
      &times;
    </button>
  </div>
</div>
