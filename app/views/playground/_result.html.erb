<%#
  The finished run, rendered server-side and swapped in over the live field
  rows. Outputs go through the same partial the consultation page uses, so a
  playground result and a real consultation can never read differently.

  Usage is shown deliberately: the person evaluating whether this product is
  worth paying for is the person who just pressed record.
%>
<% total_cost = session.usage_events.sum { |event| event.cost.to_f } %>
<% audio_seconds = session.usage_events.sum { |event| event.audio_seconds.to_f } %>
<% total_tokens = session.usage_events.sum { |event| event.total_tokens.to_i } %>
<% filled = outputs.sum { |output| output.result.is_a?(Hash) ? output.result.count { |_, v| v.present? || v == false } : 0 } %>

<section class="card card-pad">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <%= status_badge(session.status, kind: :session) %>
      <p class="text-base font-semibold text-gray-900">
        <span class="num"><%= filled %></span>
        <%= "field".pluralize(filled) %> filled
      </p>
    </div>
    <%= link_to "View as consultation", scribe_session_path(session), class: "btn btn-white btn-small" %>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div>
      <dt class="stat-label">Cost</dt>
      <dd class="stat-value"><%= format_cost(total_cost, precision: 6) %></dd>
    </div>
    <div>
      <dt class="stat-label">Audio</dt>
      <dd class="stat-value"><%= audio_seconds.positive? ? format_duration(audio_seconds) : "—" %></dd>
    </div>
    <div>
      <dt class="stat-label">Tokens</dt>
      <dd class="stat-value"><%= format_tokens(total_tokens) %></dd>
    </div>
    <div>
      <dt class="stat-label">Provider time</dt>
      <%# Summed, not wall-clock: the stages run in sequence, so this is the
          time the providers themselves accounted for. It excludes queue wait
          and upload, which is what makes it comparable between two runs. %>
      <dd class="stat-value"><%= format_latency(session.usage_events.sum { |event| event.latency_ms.to_i }) %></dd>
    </div>
  </dl>
</section>

<%#
  Per-stage breakdown — the reason to run this twice with different models.

  Grouped by stage + model rather than listed per event: a streamed recording
  meters one ASR call PER SEGMENT, so a two-minute consultation would otherwise
  print fifteen near-identical rows and bury the structuring row that actually
  varies between models.
%>
<% groups = session.usage_events.group_by { |event| [ event.function, event.provider, event.model ] } %>
<% if groups.any? %>
  <section class="card">
    <div class="card-header">
      <h2 class="text-sm font-semibold text-gray-900">Where the time went</h2>
      <p class="mt-0.5 text-xs text-gray-500">
        Run this again after changing a model assignment to compare.
      </p>
    </div>
    <div class="overflow-x-auto">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Stage</th>
            <th scope="col">Model</th>
            <th scope="col" class="text-right">Calls</th>
            <th scope="col" class="text-right">Time</th>
            <th scope="col" class="text-right">Tokens</th>
            <th scope="col" class="text-right">Cost</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% groups.each do |(function, provider, model), events| %>
            <% latency = events.sum { |event| event.latency_ms.to_i } %>
            <tr>
              <td class="whitespace-nowrap font-medium text-gray-900"><%= capability_name(function) %></td>
              <td class="mono whitespace-nowrap text-gray-600">
                <%= [ provider.presence, model.presence ].compact.join(" ").presence || "—" %>
              </td>
              <td class="num text-right text-gray-500"><%= events.size %></td>
              <td class="num whitespace-nowrap text-right text-gray-900">
                <%= format_latency(latency) %>
                <%# The per-call average is the comparable number when a
                    recording was split into many segments. %>
                <% if events.size > 1 && latency.positive? %>
                  <span class="block text-xs font-normal text-gray-500">
                    <%= format_latency(latency / events.size) %> each
                  </span>
                <% end %>
              </td>
              <td class="num text-right text-gray-700">
                <%= format_tokens(events.sum { |event| event.total_tokens.to_i }) %>
              </td>
              <td class="num text-right text-gray-700">
                <%= format_cost(events.select(&:finalized?).sum { |event| event.cost || 0 }, precision: 6) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% repaired = outputs.select { |output| Array.wrap(output.result_errors).any? } %>
    <div class="card-pad border-t border-gray-200">
      <% if repaired.any? %>
        <%# Speed is only half the question. A model that returns schema-invalid
            JSON is a worse fit for this template however fast it was. %>
        <p class="text-sm text-amber-800">
          <%= pluralize(repaired.size, "output") %> came back with validation problems — see the errors below.
          A model that fails schema validation on this template is a worse fit than a faster one that does not.
        </p>
      <% else %>
        <p class="text-sm text-gray-500">Every output validated against your template's schema first time.</p>
      <% end %>
    </div>
  </section>
<% end %>

<% if session.error.present? %>
  <%# A failed run's reason lives on the session, not only on its outputs — a
      segment that never settled is reported here and nowhere else. %>
  <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3">
    <p class="text-xs font-semibold uppercase tracking-wider text-rose-700">Run failed</p>
    <p class="mt-1 text-sm text-rose-800">
      <%= session.error.is_a?(Hash) ? (session.error["message"] || session.error.to_json) : session.error %>
    </p>
  </div>
<% end %>

<%= render partial: "scribe_sessions/output", collection: outputs, as: :output %>
