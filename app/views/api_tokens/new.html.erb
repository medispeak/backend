<% content_for :title, "Create API key" %>

<%= render "shared/page_header",
      title: "Create API key",
      subtitle: "The key authenticates your app's server against the Medispeak API." do %>
  <%= link_to "Back to API keys", api_tokens_path, class: "btn btn-white" %>
<% end %>

<div class="max-w-xl">
  <%= render "shared/error_messages", resource: @api_token %>

  <div class="card card-pad">
    <%= form_with model: @api_token, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :name, "Name", class: "field-label" %>
        <%= form.text_field :name,
              required: true,
              autofocus: true,
              placeholder: "Production server",
              class: "field-input mt-1" %>
        <p class="field-hint">A label you will recognise later — the app or environment that will use this key.</p>
      </div>

      <div>
        <%= form.label :expires_at, "Expires", class: "field-label" %>
        <%= form.select :expires_at,
              options_for_select(expiry_options, @api_token.expires_at&.iso8601),
              {},
              class: "field-input mt-1" %>
        <p class="field-hint">Every key expires. Rotate it before this date so your integration keeps working.</p>
      </div>

      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4 text-sm text-gray-600">
        The key is shown once, on the next screen. Store it in your server's secrets — it must never ship in
        client-side code or a public repository.
      </div>

      <div class="flex items-center gap-3">
        <%= form.submit "Create API key", class: "btn btn-primary" %>
        <%= link_to "Cancel", api_tokens_path, class: "btn btn-white" %>
      </div>
    <% end %>
  </div>
</div>
