<%#
  An empty screen is an invitation to act, so every empty state names the next
  step rather than just reporting absence.
  Usage: render "shared/empty_state", title: "…", body: "…", cta: link_to(…)
%>
<div class="text-center py-14 px-6">
  <h3 class="text-base font-semibold text-gray-900"><%= title %></h3>
  <p class="mt-1.5 text-sm text-gray-500 max-w-md mx-auto"><%= body %></p>
  <% if local_assigns[:cta].present? %>
    <div class="mt-5"><%= cta %></div>
  <% end %>
</div>
