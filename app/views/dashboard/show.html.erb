<div class="container mx-auto p-6">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-gray-800">MediSpeak</h1>
    <p class="mt-3 text-base leading-7 text-gray-600">
      Model-agnostic clinical scribe. Manage AI providers, models, form templates and
      inspect scribe sessions and usage from the admin.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <%= link_to "Open Admin", admin_root_path,
            class: "rounded-lg bg-gray-900 px-5 py-3 font-semibold text-white hover:bg-gray-700" %>
      <%= link_to "Scribe Sessions", admin_scribe_sessions_path,
            class: "rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white hover:bg-indigo-500" %>
      <%= link_to "Usage", admin_usage_events_path,
            class: "rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-800 hover:bg-gray-50" %>
      <%= link_to "API Tokens", api_tokens_path,
            class: "rounded-lg border border-gray-300 px-5 py-3 font-semibold text-gray-800 hover:bg-gray-50" %>
    </div>
  </div>
</div>
