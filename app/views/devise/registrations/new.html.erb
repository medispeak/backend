<% content_for :title, "Create your account" %>

<%= render "devise/shared/auth_card",
           title: "Create your account",
           subtitle: "Set up templates, mint API keys, and start capturing consultations." do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                        class: "field-input mt-1" %>
    </div>

    <div>
      <%= f.label :password, "Password", class: "field-label" %>
      <%= f.password_field :password, autocomplete: "new-password", required: true,
                           class: "field-input mt-1" %>
      <% if @minimum_password_length %>
        <p class="field-hint">At least <%= @minimum_password_length %> characters.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                           class: "field-input mt-1" %>
    </div>

    <%= f.submit "Create account", class: "btn btn-primary btn-block" %>
  <% end %>
<% end %>
