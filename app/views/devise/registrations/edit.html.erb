<% content_for :title, "Your profile" %>

<%= render "shared/page_header", title: "Your profile",
           subtitle: "Update the email and password you sign in with." %>

<div class="max-w-2xl space-y-6">
  <div class="card card-pad">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                 html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Email", class: "field-label" %>
        <%= f.email_field :email, autocomplete: "email", required: true, class: "field-input mt-1" %>
      </div>

      <div class="pt-2 border-t border-gray-200">
        <h2 class="text-sm font-semibold text-gray-900 pt-3">Change password</h2>
        <p class="field-hint">Leave these blank to keep your current password.</p>
      </div>

      <div>
        <%= f.label :password, "New password", class: "field-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "field-input mt-1" %>
        <% if @minimum_password_length %>
          <p class="field-hint">At least <%= @minimum_password_length %> characters.</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input mt-1" %>
      </div>

      <div class="pt-2">
        <%= f.label :current_password, "Current password", class: "field-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", required: true,
                             class: "field-input mt-1" %>
        <p class="field-hint">We ask for this to confirm the changes are yours.</p>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save changes", class: "btn btn-primary" %>
        <%= link_to "Cancel", root_path, class: "btn btn-white" %>
      </div>
    <% end %>
  </div>

  <div class="card card-pad border-rose-200">
    <h2 class="text-sm font-semibold text-gray-900">Delete your account</h2>
    <p class="mt-1 text-sm text-gray-500">
      This removes your login and API keys permanently. Consultations already recorded against your
      account are retained for the billing record.
    </p>
    <div class="mt-4">
      <%= button_to "Delete my account", registration_path(resource_name), method: :delete,
                    form: { data: { turbo_confirm: "Delete your account? This cannot be undone." } },
                    class: "btn btn-danger btn-small" %>
    </div>
  </div>
</div>
