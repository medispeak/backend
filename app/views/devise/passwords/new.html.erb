<% content_for :title, "Reset your password" %>

<%= render "devise/shared/auth_card",
           title: "Reset your password",
           subtitle: "Enter your email and we'll send you a link to set a new one." do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "Email", class: "field-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
                        class: "field-input mt-1" %>
    </div>

    <%= f.submit "Send reset link", class: "btn btn-primary btn-block" %>
  <% end %>
<% end %>
