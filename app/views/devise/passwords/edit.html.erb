<% content_for :title, "Choose a new password" %>

<%= render "devise/shared/auth_card", title: "Choose a new password" do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :put, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, "New password", class: "field-label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
                           class: "field-input mt-1" %>
      <% if @minimum_password_length %>
        <p class="field-hint">At least <%= @minimum_password_length %> characters.</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                           class: "field-input mt-1" %>
    </div>

    <%= f.submit "Save new password", class: "btn btn-primary btn-block" %>
  <% end %>
<% end %>
